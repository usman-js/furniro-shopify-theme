<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Jost:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
{{ 'hero-section.css' | asset_url | stylesheet_tag }}


<div class="hero-section" style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');">
    <div class="hero-box">
        <span>{{ section.settings.eyebrow }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.subtitle }}</p>
       <a href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    </div>
</div>



{% schema %}
   {
        "name": "hero",
    "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "image_picker", "id": "background_image", "label": "Background image" }
  ],       
    "presets": [
        { "name": "hero" }
    ]
   }
 {% endschema %}