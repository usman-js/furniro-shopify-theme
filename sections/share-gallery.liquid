{{  }}
<div class="section">
    <div class="heading">
        <p>{{ section.settings.tag }}</p>
        <h1>{{ section.settings.heading }}</h1>
    </div>
    <div class="image">
        <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title }}">
    </div>
</div>


{% schema %}
    {
        "name" : "gallery",
        "settings":[
                {
                    "type": "text",
                    "id": "tag",
                    "label":"Tag line"
                },
                  {
                    "type": "text",
                    "id": "heading",
                    "label":"Headline"
                },
                
        ]
    }
{% endschema %}