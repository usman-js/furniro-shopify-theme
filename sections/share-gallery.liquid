{{ 'share_gallery.css' |  asset_url | stylesheet_tag}}
<div class="gallery-section">
    <div class="heading">
        <p>{{ section.settings.tag }}</p>
        <h1>{{ section.settings.heading }}</h1>
    </div>
    <div class="image">
        <img src="{{ section.settings.featured_image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}">
    </div>
</div>


{% schema %}
    {
        "name" : "gallery",
        "settings":[
                {
                    "type": "text",
                    "id": "tag",
                    "label":"Tag line"
                },
                  {
                    "type": "text",
                    "id": "heading",
                    "label":"Headline"
                },
                {
                    "type":"image_picker",
                    "id":"featured_image",
                    "label":" Main Image"
                }
        ],
        "presets": [
            {
                "name":"gallery"
            }
        ]
    }
{% endschema %}