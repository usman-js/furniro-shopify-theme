{{ 'browse-the-range.css' | asset_url | stylesheet_tag }}

<div class="browse-section">
  <div class="browse-heading">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subtitle }}</p>
  </div>
  <div class="browse-imgs">
    <a href="{{ section.settings.dining_link }}" class="range-card">
       <p>{{ section.settings.dining_label }}</p>
    </a>
    <a href="{{ section.settings.living_link }}" class="range-card">
      <img src="{{ section.settings.living_image | image_url: width: 400 }}" alt="Living">
      <p>{{section.settings.living_image}}</p>
    </a>
    <a href="{{ section.settings.bedroom_link }}" class="range-card">
      <img src="{{ section.settings.bedroom_image | image_url: width: 600 }}" alt="Bedroom">
      <p>{{section.settings.bedroom_image}}</p>
    </a>
  </div>
</div>


{% schema %}
  {
    "name": "browse",
    "settings": [
      
      
      
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "textarea",
        "id": "subtitle",
        "label": "Subtitle"
      },
      { "type": "text", "id": "dining_label", "label": "Dining label" },
      {
        "type": "image_picker",
        "id": "dining_image",
        "label": "Dining image"
      },
      { "type": "text", "id": "living_label", "label": "Living label" },
      {
        "type": "image_picker",
        "id": "living_image",
        "label": "Living image"
      }, 
      { "type": "text", "id": "bedroom_label", "label": "Bedroom label" },
      {
        "type": "image_picker",
        "id": "bedroom_image",
        "label": "Bedroom image"
      },
      {
        "type": "url",
        "id": "dining_link",
        "label": "Dining link"
      }, 
      {
        "type": "url",
        "id": "living_link",
        "label": "Living link"
      }, 
      {
        "type": "url",
        "id": "bedroom_link",
        "label": "Bedroom link"
      }
    ],
    "presets": [
      {
        "name": "browse"
      }
    ]
  }
{% endschema %}