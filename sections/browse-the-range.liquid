<div class="browse-section">
  <div class="browse-heading">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subtitle }}</p>
  </div>
  <div class="browse-imgs">
    <div class="range-card">
      <img src="https://via.placeholder.com/300" alt="Dining">
      <p>Dining</p>
    </div>
    <div class="range-card">
      <img src="https://via.placeholder.com/300" alt="Living">
      <p>Living</p>
    </div>
    <div class="range-card">
      <img src="https://via.placeholder.com/300" alt="Bedroom">
      <p>Bedroom</p>
    </div>
  </div>
</div>


{% schema %}
    {
        "name":"brwose",
        "settings":[
             { "type": "text", "id": "heading", "label": "Heading" },
             { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
             { "type": "url", "id": "button_link", "label": "Button link" },
    ]
    }
{% endschema %}