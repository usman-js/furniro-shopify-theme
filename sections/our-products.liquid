{{ 'our-products.css' | asset_url | stylesheet_tag }}

<div class="products-section">
  <h2>{{ section.settings.heading }}</h2>

  <div class="products-grid">
    {% for product in collections[section.settings.featured_collection].products %}
      <div class="product-card">
        <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title }}">
        <p class="product-title">{{ product.title }}</p>
        <p class="product-price">{{ product.price | money }}</p>
      </div>
    {% endfor %}
  </div>
  <div class="showMoreBtn">
    <a href="{{ section.settings.button_url }}">{{ section.settings.button }}</a>
  </div>
</div>


{% schema %}
  {
    "name": "Our Products",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      }, {
        "type": "collection",
        "id": "featured_collection",
        "label": "Collection"
      }, {
        "type": "text",
        "id": "button",
        "label": " Show more button "
      },
      {
        "type": "url",
        "id": "button_url",
        "label": " Show more button link"
      }

    ],
    "presets": [
      {
        "name": "Our Products"
      }
    ]
  }
{% endschema %}